+def _with_luhn_digit(body: str) -> str:
+    for d in "0123456789":
+        n = body + d
+        total = sum((int(c) * 2 - 9 if int(c) > 4 else int(c) * 2) if i % 2 else int(c)
+                    for i, c in enumerate(reversed(n)))
+        if total % 10 == 0:
+            return n
+    raise AssertionError
