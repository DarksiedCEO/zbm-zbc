+    assert p["status"] == "NOT_CONNECTED" and p["sources_accepted"] == ["VENDOR_QUOTE", "RATE_CARD"]
+    h.refused(h.post("/inventory-port/sync", {"request_id": rid(), "vendor": "lamar"}), 503,
+              "INVENTORY_PORT_NOT_CONNECTED")
