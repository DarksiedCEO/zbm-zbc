+def _luhn(d: str) -> bool:
+    t = 0
+    for i, ch in enumerate(reversed(d)):
+        x = int(ch)
+        if i % 2:
+            x = x * 2 - 9 if x > 4 else x * 2
+        t += x
+    return t % 10 == 0
+
