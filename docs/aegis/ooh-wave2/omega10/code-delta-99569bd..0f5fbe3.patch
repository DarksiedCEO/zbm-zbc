+def aba_routing(digits: str) -> bool:
+    """A nine-digit ABA routing number: 3, 7, 1 weights over its digits sum to a multiple of ten."""
+    if len(digits) != 9:
+        return False
+    return sum(int(d) * w for d, w in zip(digits, (3, 7, 1) * 3)) % 10 == 0
