+# ---------------------------------------------------------------- AEGIS r12 security S12-1, reliability R12-2
+
+def test_r12_s12_1_every_digit_valued_character_counts():
+    # dingbat and circled digits, Ethiopic: not decimal (Nd) but digits all the same; 1a90498 kept 69 such kinds
+    import unicodedata
