# Runtime dependencies of the Railway Python images (detection-py, finance-py, legal-py, seo-py).
# These are the services' own requirements.txt pins without pytest (a test-only dependency); the four files are
# identical, and devtools/test_deploy_config.py fails if a pin here differs from them.
# Regenerate the hash-locked file (every transitive dependency pinned with its sha256) with:
#   uv pip compile deploy/python/requirements.in --generate-hashes --python-version 3.12 \
#     --python-platform x86_64-manylinux_2_28 --exclude-newer <a date at least two weeks back> \
#     [--exclude-newer-package <pkg>=<date> --upgrade-package <pkg>] -o deploy/python/requirements.lock.txt
# The bracketed part admits a newer release of one package for a security fix: the Oct 24 2026 lock takes certifi
# 2026.10.19, the fix for PYSEC-2026-4320 (pip-audit; audit-python audits this lock).
pydantic==2.13.3
fastapi==0.141.1
starlette==1.7.0
uvicorn[standard]==0.46.0
httpx==0.28.1
