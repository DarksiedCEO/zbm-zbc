   "steps": [
    {
     "action": "sender_with_consents"
    },
    {
     "action": "other_contact"
    },
    {
     "action": "inbound_email",
     "as": "message",
     "args": {
      "text": "$text"
     }
    }
   ],
   "transforms": [
    "case_flip",
    "zero_width",
    "soft_hyphen",
    "fullwidth",
    "homoglyph",
    "homoglyph_wide",
