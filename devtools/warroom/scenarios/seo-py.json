{
 "library": "seo-py",
 "version": 1,
 "department": "Search & Answer Intelligence (department 2)",
 "service": "seo-py",
 "driver": "seo_py.py",
 "basis": "ADR 0017 decisions 7-9, 11, 15, W2-1/W2-2 and W3-2: the fetcher is SSRF-safe (every hop's addresses checked, the connection made to the checked address, ports 80/443 only, one content coding decoded within the byte budget, one hard deadline); crawled content is data; a tenant-scoped caller sees its own tenant only and another tenant's object answers like a missing one; personal-data keys are refused; kill switches stop work and only Andre releases them; uploaded logs keep nothing identifying; a paid run needs Finance (31) to confirm the invoice",
 "variants_per_seed": 2,
 "scenarios": [
  {
   "id": "ssrf-internal-targets",
   "persona": "a hostile site that points the crawler at internal addresses",
   "basis": "ADR 0017 decision 11 (SSRF guard) and the suite's pinned targets (test_primitives, test_aegis_00cc66b L1)",
   "seeds": [
    {
     "extract": {
      "file": "tests/test_primitives.py",
      "test": "test_ssrf_direct_and_after_redirect_is_refused",
      "parametrize": true
     }
    },
    {
     "extract": {
      "file": "tests/test_aegis_00cc66b.py",
      "test": "test_l1_more_non_public_ranges",
      "parametrize": true
     }
    },
    {
     "literal": [
      "http://rebind.attacker.test/",
      "http://mixed.attacker.test/",
      "http://internal.attacker.test/admin",
      "http://metadata.google.internal/computeMetadata/v1/",
      "http://mapped.attacker.test/",
      "http://nat64.attacker.test/",
      "http://cgnat.attacker.test/",
      "http://0/",
      "http://[::]/",
      "http://255.255.255.255/",
      "http://[fe80::1%25eth0]/",
      "http://[::ffff:7f00:1]/",
      "http://0x7f.1/",
      "http://127.000.000.001/"
     ],
     "basis": "names the war room's fake DNS answers with private, mixed, mapped, NAT64, CGNAT or rebinding addresses (driver HOSTILE_DNS / REBIND), and more numeric spellings decision 11 names"
    }
   ],
   "input_field": "target",
   "fixed_input": {
    "vector": "home_redirect"
   },
   "params": {
    "vector": [
     "home_redirect",
     "about_redirect_chain",
     "robots_redirect",
     "llms_redirect",
     "sitemap_redirect",
     "canonical",
     "robots_sitemap_line",
     "sitemap_index_child",
     "sitemap_entry"
    ]
   },
   "steps": [
    {
     "action": "site"
    },
    {
     "action": "snapshot"
    },
    {
     "action": "plant",
     "args": {
      "target": "$target",
      "vector": "$vector"
     }
    },
    {
     "action": "audit"
    }
   ],
   "transforms": [
    "url_scheme_case",
    "url_host_case",
    "url_trailing_slash",
    "url_fragment",
    "url_tracking_query",
    "url_percent_encode",
    "url_fullwidth"
   ],
   "chain_max": 2,
   "invariants": [
    {
     "id": "audit_completes",
     "severity": "MUST",
     "check": "state_equals",
     "args": {
      "key": "audit_http",
      "value": 201
     }
    },
    {
     "id": "audit_status_completed",
     "severity": "MUST",
     "check": "state_equals",
     "args": {
      "key": "audit_status",
      "value": "completed"
     }
    },
    {
     "id": "no_request_reached_a_non_public_address",
     "severity": "MUST",
     "check": "state_equals",
     "args": {
      "key": "internal_requests",
      "value": []
     }
    },
    {
     "id": "no_internal_content_anywhere",
     "severity": "MUST",
     "check": "state_equals",
     "args": {
      "key": "secret_leaked",
      "value": false
     }
    }
