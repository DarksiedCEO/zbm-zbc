    "fullwidth",
    "homoglyph",
    "homoglyph_wide",
    "leetspeak",
    "letter_spacing",
    "letter_punct",
    "signature",
    "mixed_language",
    "injection",
    "long_body"
   ],
   "chain_max": 2,
   "invariants": [
    {
     "id": "accepted",
     "severity": "MUST",
     "check": "status_in",
     "args": {
      "step": "reply",
      "codes": [
       201
      ]
     }
    },
    {
     "id": "other_lead_untouched",
     "severity": "MUST",
     "check": "state_equals",
     "args": {
      "key": "other_suppressed",
      "value": false
     }
    },
    {
     "id": "no_echo_of_other_lead",
     "severity": "MUST",
     "check": "no_echo"
    },
    {
     "id": "opt_out_honoured_or_surfaced",
     "severity": "MUST",
     "check": "any_field_truthy",
     "args": {
      "step": "reply",
      "fields": [
       "suppressed",
       "task_id"
      ]
     }
    },
    {
     "id": "suppressed",
     "severity": "SHOULD",
     "check": "field_equals",
     "args": {
      "step": "reply",
      "field": "suppressed",
      "value": true
     }
    }
   ],
   "downgrade": {
    "homoglyph_wide": [
     "opt_out_honoured_or_surfaced",
     "suppressed"
    ]
   },
   "downgrade_basis": "wide lookalikes are outside i10_replies' documented table; the reply is still held for a person"
  },
  {
   "id": "email-reply-ordinary",
   "persona": "a prospect replying with interest, an out-of-office or a question",
   "basis": "the classifier's pinned interested / out_of_office / review rows: never refused, never another lead's data",
   "seeds": [
    {
     "extract": {
      "file": "tests/test_replies.py",
      "test": "test_classifier_table",
      "parametrize": true,
      "where": {
       "1": "interested"
      },
      "field": 0
     }
    },
    {
