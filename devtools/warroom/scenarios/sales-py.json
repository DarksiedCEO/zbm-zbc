{
 "library": "sales-py",
 "version": 1,
 "department": "Sales & Lead Generation (department 13)",
 "service": "sales-py",
 "driver": "sales_py.py",
 "basis": "ADR 0013 decision 13 and AEGIS S1-H3 / S2-C1 / S3-C1 (i10_replies.py): an opt-out reply suppresses every channel for both brands; a reply is never refused (sweep A); the label is not what protects the person: any reply holds phone outreach and opens a task for a person unless the label is an opt-out; war room leftover: disguised opt-outs are read through the shared lookalike fold and a word wholly in one non-Latin script is never read as an English opt-out (ADR 0013 'War room fixes')",
 "variants_per_seed": 3,
 "scenarios": [
  {
   "id": "email-reply-opt-out",
   "persona": "a prospect replying to cold email to opt out",
   "basis": "the classifier's pinned unsubscribe table and variants, plus its Spanish words",
   "seeds": [
    {
     "extract": {
      "file": "tests/test_replies.py",
      "test": "test_classifier_table",
      "parametrize": true,
      "where": {
       "1": "unsubscribe"
      },
      "field": 0
     }
    },
    {
     "extract": {
      "file": "tests/test_sweep_fixes.py",
      "test": "test_classifier_variants",
      "loop": 0
     }
    },
    {
     "literal": [
      "alto",
      "parar",
      "cancelar",
      "baja",
      "no mas mensajes"
     ],
     "basis": "the Spanish entries of i10_replies._UNSUB (ADR 0013 decision 13)"
    }
   ],
   "input_field": "text",
   "fixed_input": {
    "channel": "email"
   },
   "steps": [
    {
     "action": "replying_lead"
    },
    {
     "action": "other_lead"
    },
    {
     "action": "reply",
     "args": {
      "text": "$text",
      "channel": "$channel"
     }
    }
   ],
   "transforms": [
    "case_flip",
    "zero_width",
    "soft_hyphen",
    "fullwidth",
    "homoglyph",
    "homoglyph_wide",
    "leetspeak",
    "letter_spacing",
    "letter_punct",
    "html_wrap",
    "quoted_reply",
    "signature",
    "mixed_language",
    "injection",
    "long_body"
   ],
   "chain_max": 2,
   "invariants": [
    {
     "id": "accepted",
     "severity": "MUST",
     "check": "status_in",
     "args": {
      "step": "reply",
      "codes": [
       201
      ]
     }
    },
    {
     "id": "other_lead_untouched",
     "severity": "MUST",
     "check": "state_equals",
     "args": {
      "key": "other_suppressed",
      "value": false
     }
    },
    {
     "id": "no_echo_of_other_lead",
     "severity": "MUST",
     "check": "no_echo"
    },
    {
     "id": "opt_out_honoured_or_surfaced",
     "severity": "MUST",
     "check": "any_field_truthy",
     "args": {
      "step": "reply",
      "fields": [
       "suppressed",
       "task_id"
      ]
     }
    },
    {
     "id": "suppressed",
     "severity": "SHOULD",
     "check": "field_equals",
     "args": {
      "step": "reply",
      "field": "suppressed",
      "value": true
     }
    }
   ],
   "downgrade": {
    "homoglyph_wide": [
     "opt_out_honoured_or_surfaced",
     "suppressed"
    ]
   },
   "downgrade_basis": "wide lookalikes are outside i10_replies' documented table; the reply is still held for a person"
  },
