    "fullwidth",
    "homoglyph",
    "html_wrap",
    "quoted_reply",
    "signature",
    "injection",
    "long_body"
   ],
   "chain_max": 2,
   "invariants": [
    {
     "id": "accepted",
     "severity": "MUST",
     "check": "status_in",
     "args": {
      "step": "reply",
      "codes": [
       201
      ]
     }
    },
    {
     "id": "other_lead_untouched",
     "severity": "MUST",
     "check": "state_equals",
     "args": {
      "key": "other_suppressed",
      "value": false
     }
    },
    {
     "id": "no_echo_of_other_lead",
     "severity": "MUST",
     "check": "no_echo"
    },
    {
     "id": "held_or_tasked",
     "severity": "MUST",
     "check": "any_field_truthy",
     "args": {
      "step": "reply",
      "fields": [
       "held",
       "task_id",
       "suppressed"
      ]
     }
    }
   ]
  }
 ]
}
