   "fixed_input": {
    "channel": "sms"
   },
   "steps": [
    {
     "action": "replying_lead"
    },
    {
     "action": "other_lead"
    },
    {
     "action": "reply",
     "args": {
      "text": "$text",
      "channel": "$channel"
     }
    }
