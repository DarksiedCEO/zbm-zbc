# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
# virtual environments, wherever a README's `python -m venv` / `uv sync` puts them (fix wave 25, scout C5-8)
.venv/
venv/
.ruff_cache/
.mypy_cache/

# Secrets: every service refuses to start without bearer tokens, and the READMEs tell you to export them; a local
# .env holding them must never be committed (gitleaks does not recognise arbitrary shared-secret strings).
.env
.env.*
!.env.example

# Go (`go build ./cmd/orchestrator` writes `orchestrator`; `go build` at the module root writes `orchestrator-go`)
/services/orchestrator-go/orchestrator-go
/services/orchestrator-go/orchestrator
*.test
coverage.out

# Rust
target/
# Cargo.lock is intentionally tracked (not ignored): ledger-rust ships a
# binary (server), and binaries should commit their lockfile for
# reproducible builds.

# Ledger runtime data — the persisted hash-chain log is generated at
# runtime, per-environment, and must never be committed (it's evidence
# data, not source).
services/ledger-rust/ledger_data/
*.jsonl
# ...except checked-in test fixtures: a legacy ledger log written by the
# pre-Decimal server binary, used to prove old chains still verify.
!services/ledger-rust/tests/fixtures/*.jsonl

# Node / Next.js
node_modules/
.next/
next-env.d.ts
npm-debug.log*
coverage/

# OS
.DS_Store
*.tsbuildinfo
